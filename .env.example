# Solarman Wi-Fi logger
DEYE_LOGGER_IP=10.xx.xx.xx
DEYE_LOGGER_SERIAL=123455667
DEYE_LOGGER_PORT=8899
DEYE_SLAVE_ID=1

# Seconds between polls. Do not go below ~15: the logger can hang.
POLL_INTERVAL=30
# Value of the "site" label on every metric.
SITE=deye-home
LOG_LEVEL=INFO

# Grafana Cloud -> Stack -> Prometheus (or InfluxDB) -> Details.
# Leave empty to run in dry-run mode (metrics are printed to stdout).
# URL example: https://influx-prod-XX-prod-<region>.grafana.net/api/v1/push/influx/write
GRAFANA_INFLUX_URL=
# Numeric Prometheus user / instance ID
GRAFANA_USER=
# Access policy token with the metrics:write scope
GRAFANA_TOKEN=
