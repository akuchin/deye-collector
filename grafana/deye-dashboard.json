      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Есть",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Нет",
                  "color": "red",
                  "index": 1
